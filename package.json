{
  "name": "youngvista",
  "version": "0.0.0",
  "private": true,
  "description": "YoungVista: scan a room with your phone, see it in 3D and AR, and place real-size furniture.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "npm run dev -w @youngvista/web",
    "build:web": "npm run build -w @youngvista/web",
    "catalog": "npm --prefix scripts/catalog run build",
    "iphone": "node scripts/phone.mjs iphone",
    "android": "node scripts/phone.mjs android",
    "publish:iphone": "node scripts/publish.mjs iphone",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests/rules",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:rules": "npx --yes firebase-tools@15.34.1 emulators:exec --config firebase.emulators.json --only firestore,storage --project demo-young-vista \"vitest run --config tests/rules/vitest.config.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
