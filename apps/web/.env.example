# Firebase web app settings for the YoungVista website.
# Copy this file to .env.local and fill in the values from the Firebase console
# (Project settings > Your apps > Web app). .env.local is gitignored; never commit it.
# CI reads the same names from the repository's GitHub Actions secrets.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
# Local development only: talk to the Firebase emulators on this host instead of the live project
# (see the README). Leave unset for real builds.
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
