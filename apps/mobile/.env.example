# Settings for the YoungVista phone app. Copy this file to .env (gitignored; never commit it) and
# fill in the values, or copy the team's copy: cp ../../.secrets/mobile.env .env
# Firebase console > Project settings > Your apps > the web app config (the phone app uses the
# Firebase JS SDK, so it uses the web app's settings).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Google sign-in: the "Web client" OAuth client ID (Firebase Auth > Google > Web SDK configuration)
# and the iOS client ID from GoogleService-Info.plist (CLIENT_ID).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# The iOS client ID reversed (REVERSED_CLIENT_ID in GoogleService-Info.plist). Read only by
# app.config.ts at prebuild time; it goes into Info.plist as a URL scheme.
GOOGLE_IOS_URL_SCHEME=
# Apple team that signs the iOS app. Optional: defaults to Young Corporation of America.
APPLE_TEAM_ID=
# Development runs only: talk to the Firebase emulators on this host instead of the live project
# (10.0.2.2 from the Android emulator; see the README). Release builds ignore it. Leave it unset
# here and pass it when starting Metro instead.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.2.2
