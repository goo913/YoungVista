{
  "name": "youngvista-catalog-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Builds the YoungVista furniture catalog (GLB models, thumbnails, catalog.json, credits) into apps/web/public/catalog.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node src/build.ts",
    "validate": "node src/build.ts --validate-only",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3"
  }
}
