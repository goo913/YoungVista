rules_version = '2';

// YoungVista Firestore rules. Owners read and write their own rooms and scan logs; a share
// snapshot can be read by anyone who has its link. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function roomOwner(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId;
    }

    // rooms/{roomId}: only the owner can read or write it, and ownerId can never change.
    match /rooms/{roomId} {
      allow read: if isUser(resource.data.ownerId);
      allow create: if isUser(request.resource.data.ownerId);
      allow update: if isUser(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isUser(resource.data.ownerId);

      // Final picture metadata: only the owner of the room.
      match /pictures/{pictureId} {
        allow read, write: if isUser(roomOwner(roomId));
      }
    }

    // scanLogs/{logId}: one log per scan (apps/mobile/scan/scan-log.ts), so the team can see what
    // happened on real phones. The signed-in user writes it for themselves, once; nobody can
    // change it; only they can read (get, or list their own) or delete it.
    function validScanLog(d) {
      return d.keys().size() <= 60
        && d.outcome in ['saved', 'abandoned', 'failed']
        && d.createdAt is timestamp
        && d.marks is list && d.marks.size() <= 300
        && d.walls is list && d.walls.size() <= 400
        && d.planes is list && d.planes.size() <= 400
        && d.poses is list && d.poses.size() <= 7000;
    }

    match /scanLogs/{logId} {
      allow read, delete: if isUser(resource.data.ownerId);
      allow create: if isUser(request.resource.data.ownerId)
        && validScanLog(request.resource.data);
      allow update: if false;
    }

    // shares/{shareId}: a read-only snapshot for a private link. Anyone with the (long, random)
    // id can read it, nobody can list them, and only the owner of the shared room can create,
    // change or delete (revoke) it. ownerId and roomId can never change.
    // scanFits/{scanId}: a turn-around scan's fitted walls (packages/core/src/turn-scan.ts),
    // written only by the server; the owner reads it.
    match /scanFits/{scanId} {
      allow read: if isUser(resource.data.ownerId);
      allow write: if false;
    }

    match /shares/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if isUser(request.resource.data.ownerId)
        && shareId.size() >= 20
        && roomOwner(request.resource.data.roomId) == request.auth.uid;
      allow update: if isUser(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.roomId == resource.data.roomId;
      allow delete: if isUser(resource.data.ownerId);
    }
  }
}
